  {
   "n": 1,
   "t0": 0,
   "t1": 2.26,
   "from": 0,
   "to": 8,
   "text": "La película de South Park tiene un récord guines,",
   "question": false
  },
  {
   "n": 2,
   "t0": 2.84,
   "t1": 4.04,
   "from": 9,
   "to": 11,
   "text": "por decir groserías.",
   "question": false
  },
  {
   "n": 3,
   "t0": 4.66,
   "t1": 9.78,
   "from": 12,
   "to": 22,
   "text": "Verás, en 1999 estrenaron más grande, más largo y sin cortes.",
   "question": false
  },
  {
   "n": 4,
   "t0": 10.16,
   "t1": 11.58,
   "from": 23,
   "to": 29,
   "text": "Y la historia es justo sobre eso.",
   "question": false
  },
  {
   "n": 5,
   "t0": 11.92,
   "t1": 15.82,
   "from": 30,
   "to": 41,
   "text": "Los niños ven una película llena de insultos y empiezan a repetirlos.",
   "question": false
  },
  {
   "n": 6,
   "t0": 16.3,
   "t1": 19.82,
   "from": 42,
   "to": 50,
   "text": "Así que la película en sí tiene 399 groserías,",
   "question": false
  },
  {
   "n": 7,
   "t0": 20.16,
   "t1": 21.56,
   "from": 51,
   "to": 54,
   "text": "casi 5 por minuto.",
   "question": false
  },
  {
   "n": 8,
   "t0": 21.9,
   "t1": 25.38,
   "from": 55,
   "to": 67,
   "text": "Por eso entró al libro guines como la película animada con más palabrotas.",
   "question": false
  },
  {
   "n": 9,
   "t0": 25.38,
   "t1": 26.88,
   "from": 68,
   "to": 71,
   "text": "Pero lo más irónico,",
   "question": false
  },
  {
   "n": 10,
   "t0": 27.3,
   "t1": 31.54,
   "from": 72,
   "to": 85,
   "text": "la censura casi no la deja salir y aún así terminó nominada al Oscar.",
   "question": false
  },
  {
   "n": 11,
   "t0": 32.14,
   "t1": 36.58,
   "from": 86,
   "to": 99,
   "text": "O sea, una película que critica la censura rompiendo todos los récords de groserías.",
