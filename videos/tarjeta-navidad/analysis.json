 "phrases": [
  {
   "n": 1,
   "t0": 0,
   "t1": 3.56,
   "from": 0,
   "to": 9,
   "text": "¿Sabías que South Park empezó como una tarjeta de Navidad?",
   "question": true
  },
  {
   "n": 2,
   "t0": 4.24,
   "t1": 9.34,
   "from": 10,
   "to": 25,
   "text": "Verás, en los 90, dos estudiantes, Trey Parker y Matt Stone, hacían cortos con papel recortado.",
   "question": false
  },
  {
   "n": 3,
   "t0": 9.62,
   "t1": 11.88,
   "from": 26,
   "to": 31,
   "text": "Literal, cartulina, tijeras y una cámara.",
   "question": false
  },
  {
   "n": 4,
   "t0": 12.32,
   "t1": 15.36,
   "from": 32,
   "to": 44,
   "text": "Pero un ejecutivo de la tele vio uno y les pidió algo raro.",
   "question": false
  },
  {
   "n": 5,
   "t0": 15.68,
   "t1": 17.78,
   "from": 45,
   "to": 52,
   "text": "Un vídeo navideño para regalarle a sus amigos.",
   "question": false
  },
  {
   "n": 6,
   "t0": 18.38,
   "t1": 21.38,
   "from": 53,
   "to": 62,
   "text": "Así que hicieron una pelea entre Jesús y Santa Claus.",
   "question": false
  },
  {
   "n": 7,
   "t0": 22.02,
   "t1": 23.42,
   "from": 63,
   "to": 68,
   "text": "Y claro, nadie se lo guardó.",
   "question": false
  },
  {
   "n": 8,
   "t0": 23.76,
   "t1": 28.44,
   "from": 69,
   "to": 86,
   "text": "La gente lo copiaba en cintas VHS y lo pasaba de mano en mano, hasta que llegó internet.",
   "question": false
  },
  {
   "n": 9,
   "t0": 28.44,
   "t1": 31.82,
   "from": 87,
   "to": 98,
   "text": "O sea, se hizo viral antes de que existiera la palabra viral.",
   "question": false
  },
  {
   "n": 10,
   "t0": 32.34,
   "t1": 34.52,
   "from": 99,
   "to": 105,
   "text": "Por eso, en la bosta de 1997,",
   "question": false
  },
  {
   "n": 11,
   "t0": 34.82,
   "t1": 36.16,
   "from": 106,
   "to": 110,
   "text": "Comedy Central estrenó la serie.",
   "question": false
  },
  {
   "n": 12,
   "t0": 36.62,
   "t1": 38.14,
   "from": 111,
   "to": 116,
   "text": "Todo por una tarjeta de Navidad.",
   "question": false
  },
  {
   "n": 13,
   "t0": 38.6,
   "t1": 40.04,
   "from": 117,
   "to": 124,
   "text": "¿Tú qué le habrías regalado a tus amigos?",
