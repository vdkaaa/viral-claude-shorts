   "n": 1,
   "t0": 0,
   "t1": 2.52,
   "from": 0,
   "to": 8,
   "text": "Los creadores de South Park fueron a los Oscar,",
   "question": false
  },
  {
   "n": 2,
   "t0": 3.12,
   "t1": 3.8,
   "from": 9,
   "to": 10,
   "text": "con vestido.",
   "question": false
  },
  {
   "n": 3,
   "t0": 4.56,
   "t1": 10.6,
   "from": 11,
   "to": 30,
   "text": "Verás, en el año 2000 su canción Blame Canada de la película de South Park estaba nominada mejor canción original.",
   "question": false
  },
  {
   "n": 4,
   "t0": 11.16,
   "t1": 17.54,
   "from": 31,
   "to": 52,
   "text": "Así que Troy Parker y Matt Stone aparecieron en alfombra roja con copias de los vestidos de Gwyneth Paltrow y Jennifer Lopez.",
   "question": false
  },
  {
   "n": 5,
   "t0": 18.12,
   "t1": 20.4,
   "from": 53,
   "to": 58,
   "text": "Pero años después confesaron algo peor.",
   "question": false
  },
  {
   "n": 6,
   "t0": 20.82,
   "t1": 22.78,
   "from": 59,
   "to": 64,
   "text": "Esa noche iban drogados con LCD.",
   "question": false
  },
  {
   "n": 7,
   "t0": 23.38,
   "t1": 26.7,
   "from": 65,
   "to": 75,
   "text": "Imagínate estar nominado al Oscar y no saber ni dónde estás.",
   "question": false
  },
  {
   "n": 8,
   "t0": 27.42,
   "t1": 28.08,
   "from": 76,
   "to": 78,
   "text": "Y no ganaron.",
   "question": false
  },
  {
   "n": 9,
   "t0": 28.08,
   "t1": 31.64,
   "from": 79,
   "to": 90,
   "text": "El premio se lo llevó Phil Collins por una canción de Tarzan.",
