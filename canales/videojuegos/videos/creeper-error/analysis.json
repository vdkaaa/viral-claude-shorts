   "n": 1,
   "t0": 0,
   "t1": 3.64,
   "from": 0,
   "to": 9,
   "text": "El monstruo más famoso de Minecraft nació de un error.",
   "question": false
  },
  {
   "n": 2,
   "t0": 4.24,
   "t1": 8.62,
   "from": 10,
   "to": 19,
   "text": "Verás, en 2009, Marcus Person, Notz, estaba programando un cerdo.",
   "question": false
  },
  {
   "n": 3,
   "t0": 8.88,
   "t1": 12.52,
   "from": 20,
   "to": 31,
   "text": "No usaba programas de modelado, escribía las medidas directo en el código.",
   "question": false
  },
  {
   "n": 4,
   "t0": 12.86,
   "t1": 14,
   "from": 32,
   "to": 34,
   "text": "Pero se confundió.",
   "question": false
  },
  {
   "n": 5,
   "t0": 14.36,
   "t1": 19.04,
   "from": 35,
   "to": 50,
   "text": "Puso el largo donde iba el alto y el cerdo le quedó parado flaco y rarísimo.",
   "question": false
  },
  {
   "n": 6,
   "t0": 19.36,
   "t1": 20.84,
   "from": 51,
   "to": 56,
   "text": "Así que, en vez de borrarlo,",
   "question": false
  },
  {
   "n": 7,
   "t0": 21.12,
   "t1": 21.84,
   "from": 57,
   "to": 60,
   "text": "lo pintó de verde,",
   "question": false
  },
  {
   "n": 8,
   "t0": 22.16,
   "t1": 24.26,
   "from": 61,
   "to": 65,
   "text": "lo hizo perseguirte y explotar.",
   "question": false
  },
  {
   "n": 9,
   "t0": 24.26,
   "t1": 26.58,
   "from": 66,
   "to": 70,
   "text": "Ese error es el Creeper.",
   "question": false
  },
  {
   "n": 10,
   "t0": 26.84,
   "t1": 28.14,
   "from": 71,
   "to": 76,
   "text": "Hoy es el símbolo de Minecraft,",
