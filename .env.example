# Copy this file as ".env" (same folder) and fill it in. ".env" is never uploaded to GitHub.
# API key: elevenlabs.io -> Developers -> API keys (permissions: Text to Speech + Voices read)
ELEVENLABS_API_KEY=
# Your voice id: run  node core/elevenlabs.ts --voices  and copy the id of the voice you use
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
